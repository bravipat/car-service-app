# Connection string to your RDS Postgres instance.
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@carservice-db.cev280owuiwv.us-east-1.rds.amazonaws.com:5432/carservicedb

# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Public Mapbox access token (starts with "pk.") from https://account.mapbox.com/access-tokens/
# This is safe to expose to the browser — Mapbox public tokens are meant to be client-side.
NEXT_PUBLIC_MAPBOX_TOKEN=pk....

# Optional: free web search for the "Ask a question" fallback (https://tavily.com, free plan, no card).
# Without it, the fallback uses Wikipedia's free public API only.
TAVILY_API_KEY=
